# .dockerignore — keep the Docker build context small and reproducible.
#
# We deliberately DO send: the cat_de_roman_esti/ package (with fixtures), the
# frontend/ source (built in stage 1), pyproject.toml and README.md. Everything below
# is noise that would bloat the context, bust the layer cache, or leak local state.

# --- Version control / CI ---
.git
.gitignore
.github

# --- Python build + caches ---
__pycache__/
**/__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Virtualenvs (never ship a host venv into the image) ---
.venv/
venv/
env/

# --- Node / frontend build artifacts (stage 1 rebuilds these) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
**/node_modules/
**/.gate/
**/.vitest/
npm-debug.log*
yarn-error.log*

# Rebuild current assets, preserve the separate sealed legacy/ input, and never
# import a host's retired SPA or generated Go identity into a container build.
cat_de_roman_esti/web/static/
go-backend/embedfs/dist/**
go-backend/embedfs/legacy/**
go-backend/embedfs/build/**

# --- Local env / secrets (compose injects these at runtime instead) ---
.env
.env.local
.env.*
*.local

# --- Screenshots / scratch / docs not needed at runtime ---
frontend/screenshots/
screenshots/
**/test-results/
rust-backend/target/
docs/*
!docs/CRITIQUE_RUBRIC.md
# The managed-asset sync imports only the published standalone kit reader and
# the frontend budget helper. Include its literal source, not other root scripts.
scripts/*
!scripts/gui-assets.mjs

# --- Editor / OS junk ---
.idea/
.vscode/
*.swp
.DS_Store

# --- Docker's own files (no need to copy into the context) ---
Dockerfile
.dockerignore
docker-compose.yml
