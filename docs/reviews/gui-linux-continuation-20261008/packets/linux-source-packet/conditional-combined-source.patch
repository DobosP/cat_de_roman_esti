+		"Cross-Origin-Opener-Policy":"same-origin", "X-Frame-Options":"DENY", "Content-Type":"text/html; charset=utf-8"} {
+		if w.Header().Get(key) != value { t.Fatalf("privacy/security header changed: %s", key) }
