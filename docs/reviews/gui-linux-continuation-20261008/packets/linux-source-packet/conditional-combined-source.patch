+	if bytes.Count(w.Body.Bytes(), []byte(meta)) != 1 { t.Fatal("header/bootstrap mismatch") }
+	unbridged := bytes.Replace(w.Body.Bytes(), []byte(meta), nil, 1)
+	unbridged = bytes.ReplaceAll(unbridged, []byte(` nonce="`+nonce+`"`), nil)
+	if !bytes.Equal(unbridged, original) { t.Fatal("nonce bridge changed original bytes") }
+	if w.Header().Get("Cache-Control") != "no-store" || w.Header().Get("Content-Length") != strconv.Itoa(w.Body.Len()) { t.Fatal("dynamic cache/length changed") }
