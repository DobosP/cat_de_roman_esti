# Keep V99 review digests stable on Windows and Linux checkouts.
docs/reviews/v99-refinement-and-discovery/**/*.json text eol=lf
docs/reviews/v99-refinement-and-discovery/**/*.txt text eol=lf
docs/reviews/v99-refinement-and-discovery/**/*.py text eol=lf
docs/reviews/v99-refinement-and-discovery/**/*.cjs text eol=lf
docs/reviews/v99-refinement-and-discovery/**/*.md text eol=lf
docs/content-pool/v99-everyday-spaces/pool.json text eol=lf
docs/reviews/v99-refinement-and-discovery/**/*.log text eol=lf

# V1 evidence binds original bytes, including native-generator CRLF records.
# Preserve review digests on all hosts while checking actual trailing whitespace.
docs/reviews/v1-testing-release/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# The digest-pinned V1 release reserve must check out byte-identical everywhere.
cat_de_roman_esti/fixtures/release_reserve_v1.json text eol=lf
tests/fixtures/release_reserve_v1.json text eol=lf

# The private Go export has its own digest pin.
/go-backend/internal/content/bundled.json text eol=lf
/go-backend/internal/content/digest.go text eol=lf

# V1.7 raw evidence keeps native CRLF bytes and original source EOF formatting.
# JSON retains normal EOF checking; only archived Python source copies exempt it.
docs/reviews/v1-7-recognizable-content/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/reviews/v1-7-recognizable-content/reference/go-source7-native-authcore-*.py.txt -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
