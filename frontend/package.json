{
  "name": "cat-de-roman-esti-frontend",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Animated semantic-hop game SPA (cat_de_roman_esti) — Preact + Vite + TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/native-tsc.mjs --noEmit && vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "npm run test:contracts && npm run test:browser",
    "test:e2e": "playwright test",
    "typecheck": "node scripts/native-tsc.mjs --noEmit",
    "lint": "node scripts/gui-lint.mjs",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/gui-browser-tests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.2.10",
    "@fontsource-variable/inter": "5.2.8",
    "@preact/signals": "2.11.3",
    "@roedu/ui": "file:vendor/roedu-ui-1.0.11.tgz",
    "motion": "14.0.0",
    "preact": "11.0.0",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@roedu/web-kit": "file:vendor/roedu-web-kit-0.1.11.tgz",
    "@types/node": "26.6.4",
    "@typescript/typescript6": "6.0.2",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "preact-render-to-string": "6.8.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=26.10.0",
    "npm": ">=12.2.0"
  }
}
