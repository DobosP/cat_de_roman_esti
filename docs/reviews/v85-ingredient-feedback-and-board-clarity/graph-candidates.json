  "sources": {
    "cinnamon_definition": {
      "url": "https://www.kamis.ro/produse/produse-gastro/produse-gastro/scortisoara-gastro",
      "evidence": "Manufacturer identifies cinnamon as bark-derived spice; only that definition is used."
    },
    "apple_pie": {
      "url": "https://jamilacuisine.ro/placinta-cu-mere-reteta-video/",
      "evidence": "Recipe lists cinnamon in apple filling and butter in its pastry. Both are recipe associations, not universal requirements."
    },
    "gingerbread": {
      "url": "https://www.oetker.ro/produsele/p/mix-pentru-turta-dulce",
      "evidence": "Manufacturer gingerbread ingredient list explicitly includes cinnamon."
    },
    "mucenici": {
      "url": "https://jamilacuisine.ro/mucenici-muntenesti-fierti-reteta-video/",
      "evidence": "Recipe for boiled Muntenian variant uses cinnamon sticks and a vanilla pod. Label must name the boiled variant."
    },
    "biscuit_salami": {
      "url": "https://jamilacuisine.ro/salam-de-biscuiti-facut-in-casa-reteta-video/",
      "evidence": "Recipe directly lists cocoa and raisins for biscuit salami; chilled assembly does not bake the assembled dessert."
    },
    "amandina": {
      "url": "https://jamilacuisine.ro/prajitura-amandina-amandine-facute-in-casa/",
      "evidence": "Cocoa is used in sponge and cream; bitter chocolate is used in the illustrated glaze variant."
    },
    "cozonac": {
      "url": "https://jamilacuisine.ro/cozonac-cu-aluat-oparit-cozonaci-babani-si-pufosi-reteta-video/",
      "evidence": "The named cozonac recipe uses vanilla paste, cocoa and raisins; filling variants are explicitly allowed."
    },
    "halva": {
      "url": "https://feleacul.ro/produse/halva",
      "evidence": "Manufacturer lists sunflower seeds in classic and cocoa halva, and cocoa only in its cocoa variant."
    },
    "cocoa_forms": {
      "url": "https://dexonline.ro/definitie/cacao",
      "evidence": "DOOM3 gives articulated cacaua; displayed paradigm gives cacauei. Powder and drink senses are related but not identical."
    },
    "chocolate_home": {
      "url": "https://www.roberteisler.ro/retete/ciocolata-de-casa-1",
      "evidence": "Chef recipe uses cocoa powder in homemade chocolate and roasted hazelnuts as optional topping; does not prove all commercial chocolate contains cocoa powder."
    },
    "eclairs": {
      "url": "https://jamilacuisine.ro/eclere-pas-cu-pas-reteta-video/",
      "evidence": "Recipe uses a vanilla pod in cream and explicitly offers grated-chocolate cream as a variant."
    },
    "ice_cream": {
      "url": "https://jamilacuisine.ro/inghetata-de-vanilie-reteta-video/",
      "evidence": "Base uses vanilla pods; the author explicitly says cocoa can flavor that base for chocolate ice cream."
    },
    "crepes": {
      "url": "https://jamilacuisine.ro/clatite-clasice-frantuzesti-pufoase-si-delicioase-reteta-video/",
      "evidence": "Recipe has vanilla paste or essence in the batter and offers chocolate filling as a choice."
    },
    "pasca": {
      "url": "https://jamilacuisine.ro/pasca-cu-aluat-de-cozonac-reteta-video/",
      "evidence": "Recipe has raisins in sweet-cheese filling and vanilla in dough/filling."
    },
    "poale": {
      "url": "https://jamilacuisine.ro/poale-n-brau-pas-cu-pas-reteta-video/",
      "evidence": "Sweet-cheese filling includes raisins and vanilla pod. No claim that telemea belongs in this filling."
    },
    "chocolate_biscuit_salami": {
      "url": "https://desertdecasa.ro/salam-de-biscuiti/",
      "evidence": "Maria Popa recipe lists chocolate as an ingredient in this biscuit-salami variant."
    },
    "chocolate_cozonac": {
      "url": "https://jamilacuisine.ro/cozonac-pufos-cu-ciocolata-si-fistic-reteta-video/",
      "evidence": "Recipe has chocolate filling as a chosen cozonac variant."
    },
    "raisin_definition": {
      "url": "https://dexonline.ro/definitie/stafid%C4%83/846038",
      "evidence": "DEX2009 identifies raisins as dried grapes; not a synonym for fresh grapes."
    },
    "nut_category": {
      "url": "https://eur-lex.europa.eu/eli/reg/2011/1169/2013-12-06/ron/pdf",
      "evidence": "Annex II item8 groups almonds, hazelnuts, walnuts and pistachios as culinary tree nuts. Used as lexical food grouping, not botanical family or health advice."
    },
    "almond_biscuit": {
      "url": "https://www.bucataras.ro/retete/biscuiti-cu-migdale-63417.html",
      "evidence": "Named author Oana recipe places actual almond flakes on biscuits; almond essence alone would not establish the proposed link."
    },
    "almond_crescent": {
      "url": "https://teoskitchen.ro/2017/09/cornulete-cu-migdale.html",
      "evidence": "Teo recipe contains ground almonds and vanilla pod in crescent cookies; nuts may vary. This is a variant, not all cornulete."
    },
    "hazelnut_biscuit": {
      "url": "https://www.pakmaya.ro/reteta/biscuiti-cu-alune-de-padure",
      "evidence": "Manufacturer recipe explicitly places a hazelnut in each biscuit."
    },
    "sunflower_oil": {
      "url": "https://sanovita.ro/blog/de-ce-folosesti-ulei-presat-la-rece-in-bucataria-ta/",
      "evidence": "Producer describes sunflower-seed oil as extracted from seeds. Only production origin is used; unrelated nutritional claims are excluded."
    },
    "sunflower_bread": {
      "url": "https://savoriurbane.com/paine-neagra-cu-seminte-diana/",
      "evidence": "Recipe adds sunflower seeds to black bread dough; variant claim only."
    },
    "sunflower_salad": {
      "url": "https://sanovita.ro/blog/salata-vitality-cu-telina-si-seminte/",
      "evidence": "Producer recipe scatters sunflower seeds over vegetable salad; variant claim only."
    }
  },
