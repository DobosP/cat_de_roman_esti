# Gate environment keys read by scripts/gate.sh from the ext4 copy (PROGRAM.md §4.2 step 4, §9-5).
# Literal KEY=VALUE lines, LF, no inline comments, never sourced. The wrapper refuses any key it does not know and exports every key to compose.
# Paul-owned; read-only to Codex; every change is a `GATE-CHANGE:` commit (`GATE-CHANGE: toolchain <tag>` for a digest).
# Per-repo values: bootstrap/project-codex.toml-hooks.json-AGENTS-block.md §6. Keys and order here = that §6 block.
TOOLCHAIN_IMAGE=roedu-toolchain:core-v1.0-linux-20261006
# The image ID printed by `docker image inspect -f '{{.Id}}' roedu-toolchain:core-v1.0` after Paul's first build (§6 of the bootstrap doc).
TOOLCHAIN_DIGEST=sha256:2e040a5165d79be63755424f707fdb8cf609ace831ada7a9baca398ac25e12b9
COMPOSE_FILE=compose.gate.yml
PG_MAJOR=16
PG_SCRATCH_ROOT=/scratch/_temp/teacher-go-pg
# Upper bound for GOMAXPROCS / GOFLAGS=-p; a session may lower it per invocation with `--parallel N`, never raise it (§4.9).
GATE_PARALLEL_MAX=4
# report-only until the app's named milestone (cat S1 M1, ro S2A M2, social S3A M2) flips it to enforced (§4.4).
CSP_STAGE=report-only
# db service of the full profile, pinned by digest. social: social-native-db:local until S3A swaps in the kit's PostGIS + pgvector image.
GATE_DB_IMAGE=postgres:16-trixie@sha256:65b16a8b326e0cfbdf33fa7e783f2a0cb352a61448616ccccfd616ef42aa0f65
# Dockerfile of the one-image-per-app build (`image`, and the `app` service of `full`).
APP_DOCKERFILE=Dockerfile.gui
# Extra space-separated rsync patterns that `gen` and `deps` bring back on top of the wrapper's built-in lists. ro_teacher and social: *.templ package-lock.json go.mod go.sum
SYNC_BACK=
# social only, filled by Paul before `qualify`: GO_EXECUTABLE RELEASE_IMAGE PRIVATE_NETWORK DISPOSABLE_DSN ABSOLUTE_SCRATCH (a throwaway DSN, never a real credential).
QUALIFY_ARGS=
