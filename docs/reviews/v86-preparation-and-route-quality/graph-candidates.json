  "sources": {
    "egg_parts": {
      "url": "https://dexonline.ro/definitie/g%C4%83lbenu%C8%99/902347",
      "evidence": "Dictionary distinguishes yolk inside the egg and surrounding white; not interchangeable ingredients."
    },
    "cozonac": {
      "url": "https://jamilacuisine.ro/cozonac-cu-aluat-oparit-cozonaci-babani-si-pufosi-reteta-video/",
      "evidence": "The recipe puts yolks into dough and whipped whites into the walnut/cocoa filling. Author kneads using a mixer; variants are not universal."
    },
    "amandina": {
      "url": "https://jamilacuisine.ro/prajitura-amandina-amandine-facute-in-casa/",
      "evidence": "Cocoa sponge uses eggs; cream uses powdered sugar. Separate whipped whites are directly confirmed by the national-TV recipe source."
    },
    "amandina_whites": {
      "url": "https://www.protv.ro/articol/39442-reteta-amandina",
      "evidence": "The demonstrated recipe mixes the separately prepared egg-white and yolk masses into the sponge."
    },
    "pasca_whites": {
      "url": "https://bucate-aromate.ro/2015/03/pasca-fara-aluat-cu-branza-de-vaci-si-multe-stafide/",
      "evidence": "Original recipe beats whites to stiff foam then folds them into a crustless sweet-cheese Easter bake."
    },
    "vanilla_cream": {
      "url": "https://www.oetker.ro/retete/r/crema-de-vanilie-cu-amidon",
      "evidence": "Manufacturer recipe lists five yolks, milk, sugar, starch and a vanilla pod for the pastry cream. Each is a direct ingredient in this variant."
    },
    "yolk_icecream": {
      "url": "https://jamilacuisine.ro/inghetata-de-vanilie-reteta-video/",
      "evidence": "Author recipe uses six yolks with milk, cream and vanilla for a cooked custard subsequently frozen."
    },
    "powdered_sugar": {
      "url": "https://cio.ro/produse/zahar-pudra-500g",
      "evidence": "Producer states that powdered sugar is finely milled sugar and names doughnuts and crescent cookies among its dusting uses."
    },
    "chantilly": {
      "url": "https://www.dulceromanie.ro/mix-and-match/crema-chantilly",
      "evidence": "Test-kitchen recipe combines cream, powdered sugar and actual vanilla-pod seeds into an aerated cream. It is one whipped-cream variant, not a synonym claim."
    },
    "milk_powder_process": {
      "url": "https://rei.gov.ro/teza-doctorat-document/8291115e5e594d9c34e-Teza-de-doctorat-Ienovan_signed.pdf",
      "evidence": "Institutionally archived dairy research defines milk powder as dehydrated milk. Only the production relation is used."
    },
    "milk_powder_uses": {
      "url": "https://www.oetker.ro/produsele/p/lapte-praf-250g",
      "evidence": "Producer names use in homemade chocolate and coffee drinks; generic powdered milk is not made an alias for infant formula."
    },
    "milk_powder_icecream": {
      "url": "https://gelaterialaromana.ro/wp-content/uploads/2023/03/lista-ingrediente-la-romana-06032023.pdf",
      "evidence": "Gelateria original ingredient list contains skimmed milk powder in named ice-cream bases. No nutritional or superiority claim is used."
    },
    "whipped_cream": {
      "url": "https://www.hendi.ro/blog/cum-se-face-frisca-iata-cele-mai-simple-metode",
      "evidence": "Equipment producer explains whipping chilled suitable sweet cream with a mixer, optional powdered sugar/vanilla, and keeping the finished foam cold. Fermented sour cream is not promised to whip."
    },
    "savarina": {
      "url": "https://jamilacuisine.ro/savarine-de-casa-reteta-video/",
      "evidence": "Author recipe decorates soaked savarinas with abundant whipped cream."
    },
    "eclairs": {
      "url": "https://jamilacuisine.ro/eclere-pas-cu-pas-reteta-video/",
      "evidence": "Author recipe fills eclairs with vanilla cream and offers whipped cream as an optional addition."
    },
    "whipped_starch_icecream": {
      "url": "https://www.auchan.ro/inspiratie-si-savoare/retete-cu-imagini/inghetata",
      "evidence": "Retailer recipe for caramel ice cream thickens milk using corn starch and folds beaten whipped cream into the cooled base before freezing."
    },
    "starch_eclairs": {
      "url": "https://www.oetker.ro/retete/r/mini-eclere",
      "evidence": "Manufacturer uses starch in this mini-eclair dough variant and whips a cream filling. The starch link does not claim every eclair needs starch or yeast."
    },
    "starch_product": {
      "url": "https://www.oetker-professional.ro/produsele-noastre/gustin-amidon-alimentar-fin",
      "evidence": "Producer identifies corn starch and use in sauces; the graph keeps the culinary qualifier and does not capture laundry/industrial starch."
    },
    "freezer_manual": {
      "url": "https://documents.beko.com/Refrigerator/7202947607/ro-RO/3450429551106844043.html",
      "evidence": "Manufacturer refrigerator/freezer manual assigns ice cream to freezer shelves and distinguishes the refrigerating compartment; supports a freezer component in some refrigerators, not ordinary fridge shelves freezing ice cream."
    },
    "freezer_storage": {
      "url": "https://www.arctic.ro/blog/idei-practice/congelarea-alimentelor-ce-mancare-se-poate-congela",
      "evidence": "Producer lists frozen bread and selected pasteurized/semi-skimmed milk, and discusses berries generically. The whole-milk texture caveat remains; explicit strawberry processing is corroborated separately. No times or safety advice enter the graph."
    },
    "mixer": {
      "url": "https://www.philips.ro/c-p/HR3745_00/viva-collection-mixer",
      "evidence": "Manufacturer documents beating egg whites and dough attachments; equipment-to-ingredient labels describe actions, not physical creation of an ingredient."
    },
    "freezer_strawberries": {
      "url": "https://comprodcoop.ro/capsune-congelate/",
      "evidence": "Original Romanian producer explicitly describes strawberries passing through a continuous freezer, then being packaged and stored frozen. Only processing/storage evidence is used; its health claims are excluded."
    },
    "milk_powder_definition": {
      "url": "https://legislatie.just.ro/Public/DetaliiDocument/175376",
      "evidence": "Original government text, Annex1 point2, defines milk powder as a dehydrated solid produced by removing water from milk. This corroborates the production definition only, without a present-day compliance claim."
    },
    "milk_powder_icecream_alternate": {
      "url": "https://gelaterialaromana.ro/wp-content/uploads/2025/03/meniu-romania-mar-2025.pdf",
      "evidence": "Same producer original March2025 indexed menu lists skimmed milk powder in milk-chocolate and salted-caramel ice-cream bases. This corroboration uses indexed original recipe text; complete direct PDF access is not claimed."
    }
  },
