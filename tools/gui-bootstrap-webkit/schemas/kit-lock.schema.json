{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "core_tag",
    "archives"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "core_tag": {
      "type": "string",
      "pattern": "^core-v[0-9]+\\.[0-9]+$"
    },
    "archives": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false
}
